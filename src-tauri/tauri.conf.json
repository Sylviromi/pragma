{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pragma",
  "version": "0.1.3",
  "identifier": "dev.pragma.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pragma",
        "label": "main",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Pragma",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2025 Pragma contributors",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sylviromi/pragma/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQ0Y1N0M4NUYxOTE2Q0MKUldUTUZobGZ5RmZQK2lUWnhDWGdtaVJISkdCNlluNFI2RlJtME5TT3Yyem83MDFBRS9admZIalkK"
    }
  }
}
